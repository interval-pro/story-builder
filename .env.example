# Where this installation lives: the engine, its agent prompts and its state.
# Leave it unset to use the directory the services are started from.
INSTALL_ROOT=/absolute/path/to/this/installation

# Optional. A first repository to register when the installer runs. Projects are
# normally added from the cockpit, and an installation with none is perfectly
# normal: you start it and add the first one there.
# PROJECT_ROOT=/absolute/path/to/a/repository

# Worktrees and artifacts live beside the installation, in INSTALL_ROOT.state,
# so installing a new version does not delete the state the database indexes.
#
# WORKSPACES_ROOT must not be inside ~/.claude, ~/.config or ~/.ssh. The agents
# run as Claude Code sessions whose working directory is the worktree, and the CLI
# refuses to write to paths it considers sensitive: an agent in such a worktree
# reads everything, writes nothing, and reports honestly that it implemented
# nothing, four fix cycles in a row. The system refuses the path instead.
# STATE_ROOT=
# WORKSPACES_ROOT=
# ARTIFACTS_ROOT=

# One Postgres per installation, so two installations never collide.
PG_CONTAINER=ai-engine-postgres
PG_PORT=5433
DATABASE_URL=postgres://ai_engine:ai_engine@localhost:5433/ai_engine

# Which engine runs the agents.
#   claude-code  runs each agent as a headless Claude Code session inside the
#                task worktree, using your existing CLI login. No API key needed.
#   builtin      uses the in-process tool loop and the AI_* settings below.
AGENT_ENGINE=claude-code
CLAUDE_BINARY=claude
# Optional model override for the CLI. Leave empty to use your CLI default.
CLAUDE_MODEL=
CLAUDE_TIMEOUT_MS=3600000
# Each agent runs twice: once exploring with tools, once writing the answer with
# every tool off. Writing a long document is not the quicker half.
CLAUDE_RESULT_TIMEOUT_MS=3600000
# Lets an agent delegate to a subagent. Off, and it should stay off: each subagent
# opens its own context window, and none of the five agents has a reason to
# delegate. If you do turn it on, one subagent at a time is the limit; several at
# once is exactly the shape that multiplies spend and nothing in this lifecycle
# needs fan-out. The CLI has no flag for that limit, so it is on you, not us.
AGENT_ALLOW_SUBAGENTS=false

# Only used when AGENT_ENGINE=builtin.
AI_PROVIDER=mock
AI_MODEL=claude-opus-5
AI_API_KEY=

# Required for autonomous pushing. The worker injects this token per push, so it
# never depends on a desktop credential helper and never lands in .git/config.
# A fine-grained token with "Contents: read and write" and "Pull requests: read
# and write" on this repository is enough.
# Without it the system stops at a local branch instead of a pull request.
GITHUB_TOKEN=

# Task sandboxes. Set to false to run tasks in host Git worktrees instead.
SANDBOX_DOCKER_ENABLED=true
SANDBOX_IMAGE=ai-engine/sandbox:latest
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=4g

# How many fix cycles before a story waits for you. The cockpit's Settings screen
# overrides this without a restart.
MAX_QA_ITERATIONS=5

# How many loops each worker runs. The real limit on concurrent work is the
# queue's own setting, which is global and lives in the cockpit: a worker loop
# that cannot claim a slot simply waits.
WORKER_CONCURRENCY=2

# How long a claimed job is held before it is treated as abandoned. Clamped to at
# least 120: the worker renews every max(30s, lease/3), and a shorter lease lets
# the orchestrator reclaim a job that never stopped, which puts a second agent in
# the same worktree.
JOB_LEASE_SECONDS=900

LOG_LEVEL=info

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
