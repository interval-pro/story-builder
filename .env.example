# The repository this installation manages. Mounted into every service.
PROJECT_ROOT=/absolute/path/to/your/repository

DATABASE_URL=postgres://ai_engine:ai_engine@localhost:5433/ai_engine

# AI provider: anthropic, openai or mock. The mock provider needs no key and
# lets the whole lifecycle run offline with placeholder output.
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5
AI_API_KEY=

# Optional. Without a token the system stops at a local branch instead of a PR.
GITHUB_TOKEN=

# Task sandboxes. Set to false to run tasks in host Git worktrees instead.
SANDBOX_DOCKER_ENABLED=true
SANDBOX_IMAGE=ai-engine/sandbox:latest
SANDBOX_CPU_LIMIT=2
SANDBOX_MEMORY_LIMIT=4g

MAX_QA_ITERATIONS=5
WORKER_CONCURRENCY=2
LOG_LEVEL=info

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
